{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plain-blog",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
